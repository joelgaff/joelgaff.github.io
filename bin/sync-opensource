#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Regenerate _data/opensource.yml from GitHub.
#
#   bin/sync-opensource
#
# Writes a committed data file rather than fetching at build time, so the site
# builds without network access and every change shows up in a reviewable diff.
# Re-run it whenever you ship a plugin or land a PR, then commit the result.
#
# Needs the `gh` CLI, authenticated (`gh auth status`). In CI, set GH_TOKEN.

require "json"
require "yaml"
require "open3"
require "time"

USER = "joelgaff"

# Which of my own repos count as plugins: non-fork, public, name matches this.
# Widen the pattern here if a plugin lands outside the omarchy- namespace.
PLUGIN_NAME = /\Aomarchy-/

# MISE_QUIET keeps mise's shim banner out of stdout, which would corrupt the JSON.
def gh(*args)
  out, err, status = Open3.capture3({ "MISE_QUIET" => "1" }, "gh", *args)
  abort "gh #{args.join(' ')} failed:\n#{err}" unless status.success?
  JSON.parse(out)
rescue JSON::ParserError => e
  abort "gh #{args.join(' ')} returned unparseable output:\n#{out}\n(#{e.message})"
end

def stars_label(count)
  return count.to_s if count < 1000

  "#{(count / 100.0).round / 10.0}k"
end

# ---- plugins I author and maintain ------------------------------------------
repos = gh("repo", "list", USER, "--limit", "100", "--visibility", "public",
           "--source", "--json", "name,description,url,primaryLanguage,pushedAt")

plugins = repos
  .select { |r| r["name"] =~ PLUGIN_NAME }
  .sort_by { |r| r["pushedAt"] }.reverse
  .map do |r|
    body = r["description"].to_s.strip
    body = "#{body}." unless body.empty? || body.end_with?(".", "!", "?")
    lang = r.dig("primaryLanguage", "name")
    { "name" => r["name"], "url" => r["url"],
      "body" => [body, lang && "#{lang}."].compact.reject(&:empty?).join(" ") }
  end

# ---- PRs of mine that were merged into someone else's project ---------------
found = gh("api", "-X", "GET", "search/issues", "--raw-field",
           "q=is:pr author:#{USER} is:merged -user:#{USER}", "--jq", ".items")

stars = {}
merged = found.map { |pr|
  repo = pr["repository_url"].split("/").last(2).join("/")
  stars[repo] ||= gh("api", "repos/#{repo}", "--jq", ".stargazers_count")
  { "repo" => repo, "number" => pr["number"], "title" => pr["title"].strip,
    "url" => pr["pull_request"]["html_url"], "closed_at" => pr["closed_at"] }
}.sort_by { |pr| pr["closed_at"] }.reverse.map { |pr|
  when_merged = Time.parse(pr["closed_at"]).strftime("%B %Y") rescue nil
  detail = ["#{pr['repo']} &middot; #{stars_label(stars[pr['repo']])} stars",
            "##{pr['number']}", when_merged].compact.join(" &middot; ")
  { "name" => pr["title"], "url" => pr["url"], "body" => detail }
}


header = <<~TXT
  # Generated by bin/sync-opensource — do not hand-edit; re-run the script.
  # No sync timestamp here on purpose: it would make every run a change to commit.
  #
  # plugins - non-fork repos of mine matching #{PLUGIN_NAME.inspect}
  # merged  - my PRs merged into projects I don't own
TXT

path = File.expand_path("../_data/opensource.yml", __dir__)
File.write(path, header + { "plugins" => plugins, "merged" => merged }.to_yaml.sub(/\A---\n/, "\n"))

puts "wrote #{path}"
puts "  #{plugins.size} plugins, #{merged.size} merged PRs"
